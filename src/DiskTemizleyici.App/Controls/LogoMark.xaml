<UserControl x:Class="DiskTemizleyici.App.Controls.LogoMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="64" Height="64">
    <!-- App mark: a black tile with a disk-usage ring. Drawn on a 64×64 grid and scaled with Viewbox. -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="64" Height="64">
            <Rectangle Width="64" Height="64" RadiusX="16" RadiusY="16" Fill="#000000" Stroke="#2EFFFFFF" StrokeThickness="1" />
            <!-- ring track -->
            <Ellipse Canvas.Left="15" Canvas.Top="15" Width="34" Height="34" Stroke="#26FFFFFF" StrokeThickness="7" />
            <!-- used space (white) -->
            <Path Data="M37.81,16.03 A17,17 0 1 1 18.98,42.93" Stroke="#FFFFFF" StrokeThickness="7"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <!-- space you get back (honey) -->
            <Path Data="M16.03,37.81 A17,17 0 0 1 26.19,16.03" StrokeThickness="7"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                        <GradientStop Color="#FF8A1F" Offset="0" />
                        <GradientStop Color="#FFC857" Offset="1" />
                    </LinearGradientBrush>
                </Path.Stroke>
            </Path>
            <!-- spindle -->
            <Ellipse Canvas.Left="29" Canvas.Top="29" Width="6" Height="6" Fill="#FFFFFF" />
        </Canvas>
    </Viewbox>
</UserControl>
