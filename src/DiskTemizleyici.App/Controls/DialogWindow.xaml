<Window x:Class="DiskTemizleyici.App.Controls.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="Height" Width="500"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True">
    <Grid Margin="24" x:Name="Root" RenderTransformOrigin="0.5,0.5" Opacity="0">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="Scale" ScaleX="0.94" ScaleY="0.94" />
        </Grid.RenderTransform>
        <!-- shadow layer kept separate so text stays crisp -->
        <Border CornerRadius="22" Background="#000000">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="Black" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="22" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}"
                BorderThickness="1" Padding="24,22,24,20" MouseLeftButtonDown="OnDrag">
            <StackPanel>
                <DockPanel>
                    <Border x:Name="IconTile" DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12"
                            Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                        <TextBlock x:Name="IconGlyph" Style="{StaticResource Icon}" FontSize="17" Text="&#xE946;"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <TextBlock x:Name="TitleText" Margin="14,0,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="18"
                               FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" Margin="54,10,0,0">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" LineHeight="20" />
                </ScrollViewer>
                <StackPanel x:Name="ButtonRow" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" MinWidth="96" Margin="0,0,10,0" Click="OnCancel" IsCancel="True" />
                    <Button x:Name="OkButton" Style="{StaticResource AccentButton}" MinWidth="96" Click="OnOk" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
