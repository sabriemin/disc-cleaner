<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- line numbers in crash reports, also in the single-file exe -->
    <DebugType>embedded</DebugType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DiskTemizleyici</AssemblyName>
    <RootNamespace>DiskTemizleyici.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\app.ico')">Assets\app.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>DiskTemizleyici</Product>
    <Description>Find what fills your disk and clean it safely.</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!--
      Since .NET 9 the exe is marked CET-compatible. With that on, some third-party Explorer extensions that load
      into the folder picker or the Recycle Bin calls can crash the app (https://github.com/dotnet/wpf/issues/10305).
      Keep the .NET 8 behaviour until that is fixed.
    -->
    <CETCompat>false</CETCompat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" Condition="Exists('Assets\app.ico')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiskTemizleyici.Core\DiskTemizleyici.Core.csproj" />
  </ItemGroup>

</Project>
