<Window x:Class="DiskTemizleyici.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:DiskTemizleyici.App.Localization"
        xmlns:vm="clr-namespace:DiskTemizleyici.App.ViewModels"
        xmlns:app="clr-namespace:DiskTemizleyici.App"
        xmlns:c="clr-namespace:DiskTemizleyici.App.Controls"
        Title="{Binding [AppTitle], Source={x:Static l:Loc.I}}"
        Icon="Assets/app.ico"
        Width="1240" Height="820" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextBrush}"
        Background="{DynamicResource WindowBackgroundBrush}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Key="Delete" Command="{Binding MoveToRecycleCommand}" CommandParameter="{Binding CurrentItem}" />
        <KeyBinding Key="Delete" Modifiers="Shift" Command="{Binding DeletePermanentCommand}" CommandParameter="{Binding CurrentItem}" />
        <KeyBinding Key="Enter" Command="{Binding OpenInExplorerCommand}" CommandParameter="{Binding CurrentItem}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyPathCommand}" CommandParameter="{Binding CurrentItem}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCurrentCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding ShowViewCommand}" CommandParameter="0" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding ShowViewCommand}" CommandParameter="1" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding ShowViewCommand}" CommandParameter="3" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding ShowViewCommand}" CommandParameter="2" />
    </Window.InputBindings>

    <Window.Resources>
        <app:EqualsConverter x:Key="Eq" />
        <app:EqualsToVisibilityConverter x:Key="EqVis" />
        <app:BoolToVisibilityConverter x:Key="Vis" />
        <app:InverseBoolConverter x:Key="Not" />

        <!-- Context menu shared by the folder tree and the large-file list. -->
        <ContextMenu x:Key="ItemMenu" x:Shared="False">
            <MenuItem Header="{Binding [OpenInExplorer], Source={x:Static l:Loc.I}}" InputGestureText="Enter"
                      Command="{Binding PlacementTarget.Tag.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon><TextBlock Text="&#xE838;" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{Binding [CopyPath], Source={x:Static l:Loc.I}}" InputGestureText="Ctrl+C"
                      Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon><TextBlock Text="&#xE8C8;" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{Binding [Rescan], Source={x:Static l:Loc.I}}" InputGestureText="F5"
                      Command="{Binding PlacementTarget.Tag.RescanCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon><TextBlock Text="&#xE72C;" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{Binding [MoveToRecycle], Source={x:Static l:Loc.I}}" InputGestureText="Del"
                      Command="{Binding PlacementTarget.Tag.MoveToRecycleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon><TextBlock Text="&#xE74D;" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{Binding [DeletePermanent], Source={x:Static l:Loc.I}}" InputGestureText="Shift+Del" Foreground="{DynamicResource DangerBrush}"
                      Command="{Binding PlacementTarget.Tag.DeletePermanentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon><TextBlock Text="&#xE7BA;" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <Style x:Key="TreeRow" TargetType="TreeViewItem" BasedOn="{StaticResource FolderTreeItem}">
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}" />
            <Setter Property="ContextMenu" Value="{StaticResource ItemMenu}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        </Style>

        <Style x:Key="FileRow" TargetType="ListBoxItem" BasedOn="{StaticResource PlainListItem}">
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
            <Setter Property="ContextMenu" Value="{StaticResource ItemMenu}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        </Style>

        <!-- a whole row that is clickable (file type categories and extensions) -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewHost" TargetType="Grid">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- ambient glow, like a wallpaper shining through -->
        <Rectangle Fill="{DynamicResource GlowBrush}" IsHitTestVisible="False" />
        <Rectangle Fill="{DynamicResource CoolGlowBrush}" IsHitTestVisible="False" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ======================================================== title bar -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <c:LogoMark Width="26" Height="26" />
                    <TextBlock Text="{Binding [AppTitle], Source={x:Static l:Loc.I}}" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="14" />
                </StackPanel>

                <!-- the island: hangs from the top edge and shows what is going on -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="14" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Fill="{DynamicResource IslandBrush}" Data="M0,0 L14,0 L14,14 A14,14 0 0 0 0,0 Z" VerticalAlignment="Top" />
                    <Border x:Name="Island" Grid.Column="1" Background="{DynamicResource IslandBrush}" CornerRadius="0,0,20,20"
                            Height="40" Width="260" Padding="18,0" ToolTip="{Binding Status}">
                        <DockPanel VerticalAlignment="Center">
                            <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,10,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource LiveDotBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="Pulse">
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.6" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="Pulse" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <ProgressBar DockPanel.Dock="Right" Style="{StaticResource PillBar}" Width="64" Height="4" Margin="12,0,0,0"
                                         Value="{Binding ProgressValue}" Visibility="{Binding IsCleaning, Converter={StaticResource Vis}}" />
                            <TextBlock x:Name="IslandLabel" Text="{Binding IslandText}" Foreground="White" FontWeight="SemiBold" FontSize="12.5"
                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Path Grid.Column="2" Fill="{DynamicResource IslandBrush}" Data="M14,0 L0,0 L0,14 A14,14 0 0 1 14,0 Z" VerticalAlignment="Top" />
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource IconButton}" Content="&#xE7EF;" Margin="0,8,2,0" Foreground="{DynamicResource TextMutedBrush}" AutomationProperties.Name="{Binding [RunAsAdmin], Source={x:Static l:Loc.I}}"
                            Command="{Binding RestartAsAdminCommand}" WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="{Binding [AdminTip], Source={x:Static l:Loc.I}}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                    <ToggleButton x:Name="SettingsToggle" Style="{StaticResource IconToggle}" Content="&#xE713;" Margin="0,8,10,0"
                                  WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{Binding [Settings], Source={x:Static l:Loc.I}}"
                                  AutomationProperties.Name="{Binding [Settings], Source={x:Static l:Loc.I}}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=SettingsPopup, Converter={StaticResource Not}}" />
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="OnMinimize" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="{Binding [Minimize], Source={x:Static l:Loc.I}}"
                            ToolTip="{Binding [Minimize], Source={x:Static l:Loc.I}}" />
                    <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="OnMaximize" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="{Binding [Maximize], Source={x:Static l:Loc.I}}"
                            ToolTip="{Binding [Maximize], Source={x:Static l:Loc.I}}" />
                    <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="{Binding [Close], Source={x:Static l:Loc.I}}"
                            ToolTip="{Binding [Close], Source={x:Static l:Loc.I}}" />
                </StackPanel>

                <!-- settings popover -->
                <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsToggle}" Placement="Bottom"
                       HorizontalOffset="-262" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                       IsOpen="{Binding IsChecked, ElementName=SettingsToggle, Mode=TwoWay}">
                    <Grid Margin="0,0,18,18">
                        <Border CornerRadius="18" Background="#000000">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.55" Color="Black" />
                            </Border.Effect>
                        </Border>
                        <Border Width="300" CornerRadius="18" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}"
                                BorderThickness="1" Padding="18,16,18,18">
                            <StackPanel>
                                <TextBlock Text="{Binding [Settings], Source={x:Static l:Loc.I}}" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />

                                <TextBlock Text="{Binding [Appearance], Source={x:Static l:Loc.I}}" Style="{StaticResource ColumnHeader}" Margin="0,0,0,8" />
                                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="style" Content="{Binding [StyleSolid], Source={x:Static l:Loc.I}}"
                                                     IsChecked="{Binding IsGlass, Converter={StaticResource Eq}, ConverterParameter=False}" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="style" Content="{Binding [StyleGlass], Source={x:Static l:Loc.I}}"
                                                     IsChecked="{Binding IsGlass, Converter={StaticResource Eq}, ConverterParameter=True}"
                                                     IsEnabled="{Binding GlassSupported}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding [GlassNeedsWin11], Source={x:Static l:Loc.I}}" Style="{StaticResource Faint}" Margin="0,6,0,0"
                                           Visibility="{Binding GlassSupported, Converter={StaticResource Vis}, ConverterParameter=invert}" />

                                <TextBlock Text="{Binding [AccentColor], Source={x:Static l:Loc.I}}" Style="{StaticResource ColumnHeader}" Margin="0,16,0,8" />
                                <ListBox Style="{StaticResource SwatchList}" ItemsSource="{Binding Accents}" SelectedItem="{Binding SelectedAccent}" />

                                <TextBlock Text="{Binding [Language], Source={x:Static l:Loc.I}}" Style="{StaticResource ColumnHeader}" Margin="0,16,0,8" />
                                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="lang" Content="Türkçe"
                                                     IsChecked="{Binding LanguageCode, Converter={StaticResource Eq}, ConverterParameter=tr}" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="lang" Content="English"
                                                     IsChecked="{Binding LanguageCode, Converter={StaticResource Eq}, ConverterParameter=en}" />
                                    </StackPanel>
                                </Border>

                                <Border Height="1" Background="{DynamicResource SubtleBorderBrush}" Margin="0,18,0,12" />
                                <TextBlock x:Name="VersionLine" Style="{StaticResource Faint}">
                                    <Run Text="{Binding [AppTitle], Source={x:Static l:Loc.I}, Mode=OneWay}" />
                                    <Run Text="·" />
                                    <Run Text="{Binding [VersionLabel], Source={x:Static l:Loc.I}, Mode=OneWay}" />
                                    <Run Text="{Binding AppVersion, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>

            <!-- ======================================================== drives + actions -->
            <Grid Grid.Row="1" Margin="20,14,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ListBox Style="{StaticResource DriveList}" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}"
                         IsEnabled="{Binding IsIdle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DriveViewModel}">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SurfaceHoverBrush}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" FontSize="16" />
                                    </Border>
                                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Letter, Mode=OneWay}" />
                                            <Run Text="{Binding Label, Mode=OneWay}" FontWeight="Normal" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding FreeText}" Style="{StaticResource Faint}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <ProgressBar Style="{StaticResource PillBar}" Margin="0,11,0,0" Value="{Binding UsedPercent, Mode=OneWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding ScanFolderCommand}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding [ScanFolder], Source={x:Static l:Loc.I}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButton}" Command="{Binding ScanCommand}" MinWidth="110"
                            Visibility="{Binding IsScanning, Converter={StaticResource Vis}, ConverterParameter=invert}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding [Scan], Source={x:Static l:Loc.I}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" MinWidth="110" Margin="10,0,0,0"
                            ToolTip="Esc" Visibility="{Binding ShowStop, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding [Cancel], Source={x:Static l:Loc.I}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <DockPanel Grid.Row="2" Margin="26,10,26,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,4" Margin="12,0,0,0" FontSize="12"
                        Command="{Binding RestartAsAdminCommand}" Visibility="{Binding ShowDeniedButton, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7EF;" FontSize="11" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding DeniedButtonText}" />
                    </StackPanel>
                </Button>
            <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Faint}">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            </DockPanel>

            <!-- ======================================================== content card -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="16,10,16,0">
                <Grid>

                    <!-- ............................................ folders -->
                    <Grid x:Name="FoldersView" Style="{StaticResource ViewHost}"
                          Visibility="{Binding SelectedView, Converter={StaticResource EqVis}, ConverterParameter=0}">

                        <!-- empty state -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440"
                                    Visibility="{Binding ShowEmpty, Converter={StaticResource Vis}}">
                            <c:LogoMark Width="76" Height="76" />
                            <TextBlock Text="{Binding [EmptyTitle], Source={x:Static l:Loc.I}}" FontFamily="{StaticResource DisplayFont}" FontSize="24"
                                       FontWeight="SemiBold" TextAlignment="Center" Margin="0,22,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding [EmptyText], Source={x:Static l:Loc.I}}" Style="{StaticResource Muted}" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20" />
                            <Button Style="{StaticResource AccentButton}" Command="{Binding ScanCommand}" HorizontalAlignment="Center" Margin="0,22,0,0" Padding="26,11">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Margin="0,0,9,0" />
                                    <TextBlock Text="{Binding [Scan], Source={x:Static l:Loc.I}}" FontSize="14" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- scanning -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="680"
                                    Visibility="{Binding IsScanning, Converter={StaticResource Vis}}">
                            <Grid Width="68" Height="68">
                                <Ellipse Stroke="{DynamicResource BarTrackBrush}" StrokeThickness="6" />
                                <Path Data="M34,3 A31,31 0 0 1 65,34" Stroke="{DynamicResource AccentBrush}" StrokeThickness="6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform CenterX="0" CenterY="0" />
                                    </Path.RenderTransform>
                                    <Path.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:0.9" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Path.Triggers>
                                </Path>
                            </Grid>
                            <TextBlock Text="{Binding [ScanningTitle], Source={x:Static l:Loc.I}}" FontFamily="{StaticResource DisplayFont}" FontSize="24"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,22,0,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                <Border Style="{StaticResource Chip}" Padding="12,6" CornerRadius="10" Margin="0,0,8,0">
                                    <TextBlock>
                                        <Run Text="{Binding ScanFilesText, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding [FilesLabel], Source={x:Static l:Loc.I}, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}" />
                                    </TextBlock>
                                </Border>
                                <Border Style="{StaticResource Chip}" Padding="12,6" CornerRadius="10">
                                    <TextBlock>
                                        <Run Text="{Binding ScanBytesText, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding [ReadLabel], Source={x:Static l:Loc.I}, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}" />
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding ScanPath}" Style="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,14,0,0"
                                       TextTrimming="CharacterEllipsis" MaxWidth="640" />
                        </StackPanel>

                        <!-- results -->
                        <Grid Visibility="{Binding HasScan, Converter={StaticResource Vis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="32,16,24,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding [ColName], Source={x:Static l:Loc.I}}" Style="{StaticResource ColumnHeader}" />
                                <TextBlock Grid.Column="2" Text="{Binding [ColSize], Source={x:Static l:Loc.I}}" Style="{StaticResource ColumnHeader}" TextAlignment="Right" />
                                <TextBlock Grid.Column="3" Margin="16,0,0,0" Text="{Binding [ColShare], Source={x:Static l:Loc.I}}" Style="{StaticResource ColumnHeader}" />
                                <TextBlock Grid.Column="4" Text="{Binding [ColFiles], Source={x:Static l:Loc.I}}" Style="{StaticResource ColumnHeader}" TextAlignment="Right" />
                            </Grid>
                            <TreeView Grid.Row="1" Style="{StaticResource FolderTree}" ItemsSource="{Binding Tree}"
                                      ItemContainerStyle="{StaticResource TreeRow}" Margin="0,0,0,8"
                                      SelectedItemChanged="OnTreeSelectionChanged"
                                      PreviewMouseRightButtonDown="OnTreeRightButtonDown">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type vm:FolderItemViewModel}" ItemsSource="{Binding Children}"
                                                              ItemContainerStyle="{StaticResource TreeRow}">
                                        <Grid Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource SurfaceHoverBrush}">
                                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                            </Border>
                                            <DockPanel Grid.Column="1" Margin="10,0,12,0">
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Margin="8,0,0,0" ToolTip="{Binding RowTip}"
                                                        Visibility="{Binding HasNote, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding RowTip}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSpecialRow}" Value="True">
                                                                    <Setter Property="FontStyle" Value="Italic" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <DockPanel Grid.Column="3" Margin="16,0,0,0">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ShareText}" Width="52" TextAlignment="Right"
                                                           Style="{StaticResource Faint}" VerticalAlignment="Center" />
                                                <ProgressBar Style="{StaticResource PillBar}" Value="{Binding Share, Mode=OneWay}" />
                                            </DockPanel>
                                            <TextBlock Grid.Column="4" Text="{Binding FilesText}" TextAlignment="Right" Style="{StaticResource Faint}" VerticalAlignment="Center" />
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </Grid>

                    <!-- ............................................ large files -->
                    <Grid x:Name="FilesView" Style="{StaticResource ViewHost}"
                          Visibility="{Binding SelectedView, Converter={StaticResource EqVis}, ConverterParameter=1}">
                        <TextBlock Text="{Binding [LargeEmpty], Source={x:Static l:Loc.I}}" Style="{StaticResource Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasScan, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                        <Grid Visibility="{Binding HasScan, Converter={StaticResource Vis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="18,14,24,0" Visibility="{Binding HasLargeFilesFilter, Converter={StaticResource Vis}}">
                                <Border Style="{StaticResource Chip}" Background="{DynamicResource AccentSoftBrush}" Padding="10,4" CornerRadius="9">
                                    <TextBlock Text="{Binding LargeFilesFilterText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <Button Style="{StaticResource GhostButton}" Padding="10,4" Margin="8,0,0,0" FontSize="12" Command="{Binding ClearLargeFilesFilterCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding [ClearFilter], Source={x:Static l:Loc.I}}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding [FilterEmpty], Source={x:Static l:Loc.I}}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0"
                                           Visibility="{Binding ShowFilterEmpty, Converter={StaticResource Vis}}" />
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="18,16,24,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding [ColName], Source={x:Static l:Loc.I}}" Style="{StaticResource ColumnHeader}" />
                                <TextBlock Grid.Column="2" Text="{Binding [ColModified], Source={x:Static l:Loc.I}}" Style="{StaticResource ColumnHeader}" />
                                <TextBlock Grid.Column="3" Text="{Binding [ColSize], Source={x:Static l:Loc.I}}" Style="{StaticResource ColumnHeader}" TextAlignment="Right" />
                            </Grid>
                            <ListBox Grid.Row="2" Style="{StaticResource PlainList}" ItemsSource="{Binding LargeFiles}" Margin="0,0,0,8"
                                     ItemContainerStyle="{StaticResource FileRow}" SelectedItem="{Binding SelectedLargeFile}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LargeFileViewModel}">
                                        <Grid Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource SurfaceHoverBrush}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" CornerRadius="7" Padding="8,1" Margin="10,0,0,0" Background="{DynamicResource CautionSoftBrush}"
                                                            Visibility="{Binding IsCritical, Converter={StaticResource Vis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="10" Margin="0,0,5,0" Foreground="{DynamicResource CautionBrush}" />
                                                            <TextBlock Text="{Binding CriticalText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource CautionBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Folder}" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" Style="{StaticResource Faint}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>

                    <!-- ............................................ file types -->
                    <Grid x:Name="TypesView" Style="{StaticResource ViewHost}"
                          Visibility="{Binding SelectedView, Converter={StaticResource EqVis}, ConverterParameter=3}">
                        <TextBlock Text="{Binding [TypesEmpty], Source={x:Static l:Loc.I}}" Style="{StaticResource Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasFileTypes, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                        <Grid Visibility="{Binding HasFileTypes, Converter={StaticResource Vis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="24,18,24,12">
                                <TextBlock Text="{Binding [TypesHint], Source={x:Static l:Loc.I}}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding FileTypesStale, Converter={StaticResource Vis}}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Margin="0,0,7,0"
                                               Foreground="{DynamicResource CautionBrush}" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding [TypesStale], Source={x:Static l:Loc.I}}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource CautionBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,0,10,8">
                                <ItemsControl ItemsSource="{Binding FileTypes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:FileCategoryViewModel}">
                                            <Border CornerRadius="16" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}"
                                                    BorderThickness="1" Padding="6" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Button Style="{StaticResource RowButton}" AutomationProperties.Name="{Binding Name}"
                                                            Command="{Binding DataContext.ToggleCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="200" />
                                                                <ColumnDefinition Width="100" />
                                                                <ColumnDefinition Width="28" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource SurfaceHoverBrush}">
                                                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="15" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                                                <TextBlock Text="{Binding CountText}" Style="{StaticResource Faint}" />
                                                            </StackPanel>
                                                            <DockPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ShareText}" Width="56" TextAlignment="Right" Style="{StaticResource Faint}" />
                                                                <ProgressBar Style="{StaticResource PillBar}" Value="{Binding Share, Mode=OneWay}" />
                                                            </DockPanel>
                                                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontFamily="{StaticResource DisplayFont}" FontSize="16"
                                                                       FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="4" FontSize="10" Foreground="{DynamicResource TextMutedBrush}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                                        <Setter Property="Text" Value="&#xE70D;" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                <Setter Property="Text" Value="&#xE70E;" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Button>
                                                    <ItemsControl ItemsSource="{Binding Extensions}" Margin="48,4,0,4"
                                                                  Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:FileExtensionViewModel}">
                                                                <Button Style="{StaticResource RowButton}" Padding="8,4" AutomationProperties.Name="{Binding Name}"
                                                                        Command="{Binding DataContext.FilterByExtensionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="160" />
                                                                            <ColumnDefinition Width="120" />
                                                                            <ColumnDefinition Width="100" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                        <ProgressBar Grid.Column="1" Style="{StaticResource PillBar}" Height="4" Value="{Binding Share, Mode=OneWay}" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource Faint}" TextAlignment="Right" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- ............................................ suggestions -->
                    <Grid x:Name="SuggestionsView" Style="{StaticResource ViewHost}"
                          Visibility="{Binding SelectedView, Converter={StaticResource EqVis}, ConverterParameter=2}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding SuggestionsMessage}" Style="{StaticResource Muted}" Margin="24,18,24,12" TextWrapping="Wrap" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,0,10,8">
                            <ItemsControl ItemsSource="{Binding Candidates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CandidateViewModel}">
                                        <Border CornerRadius="18" BorderThickness="1.5" Padding="16,14" Margin="0,0,0,10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource SurfaceHoverBrush}" VerticalAlignment="Top">
                                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="17" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="14,0,16,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <Border Margin="10,0,0,0" CornerRadius="7" Padding="8,2" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource SafeSoftBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCaution}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource CautionSoftBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding RiskText}" FontSize="11" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SafeBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCaution}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource CautionBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        <Border Style="{StaticResource Chip}" Margin="6,0,0,0" CornerRadius="7"
                                                                Visibility="{Binding NeedsAdmin, Converter={StaticResource Vis}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7EF;" FontSize="10" Margin="0,0,5,0" Foreground="{DynamicResource TextMutedBrush}" />
                                                                <TextBlock Text="{Binding AdminText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="19" />
                                                    <TextBlock Text="{Binding PathsText}" Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,7,0,0"
                                                               Visibility="{Binding HasPaths, Converter={StaticResource Vis}}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                                Visibility="{Binding HasStatusNote, Converter={StaticResource Vis}}">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Margin="0,0,7,0"
                                                                   Foreground="{DynamicResource CautionBrush}" VerticalAlignment="Top" />
                                                        <TextBlock Text="{Binding StatusNote}" TextWrapping="Wrap" MaxWidth="560"
                                                                   Foreground="{DynamicResource CautionBrush}" />
                                                    </StackPanel>
                                                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,6"
                                                            Command="{Binding DataContext.RestartAsAdminCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            Visibility="{Binding ShowAdminButton, Converter={StaticResource Vis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7EF;" FontSize="12" Margin="0,0,8,0" />
                                                            <TextBlock Text="{Binding [RunAsAdmin], Source={x:Static l:Loc.I}}" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0">
                                                    <TextBlock Text="{Binding SizeText}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" TextAlignment="Right" />
                                                    <TextBlock Text="{Binding FilesText}" Style="{StaticResource Faint}" TextAlignment="Right" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="3" Style="{StaticResource Switch}" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                                          IsEnabled="{Binding IsActionable}" AutomationProperties.Name="{Binding Name}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="2" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="18,12,18,14">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="mode" ToolTip="{Binding [ModeRecycleTip], Source={x:Static l:Loc.I}}"
                                                     IsChecked="{Binding PermanentDelete, Converter={StaticResource Eq}, ConverterParameter=False}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" Margin="0,0,7,0" />
                                                <TextBlock Text="{Binding [ModeRecycle], Source={x:Static l:Loc.I}}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="mode" ToolTip="{Binding [ModePermanentTip], Source={x:Static l:Loc.I}}"
                                                     IsChecked="{Binding PermanentDelete, Converter={StaticResource Eq}, ConverterParameter=True}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Margin="0,0,7,0" />
                                                <TextBlock Text="{Binding [ModePermanent], Source={x:Static l:Loc.I}}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock Text="{Binding [SelectedLabel], Source={x:Static l:Loc.I}}" Style="{StaticResource Faint}" TextAlignment="Right" />
                                        <TextBlock Text="{Binding SelectedTotalText}" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" TextAlignment="Right" />
                                    </StackPanel>
                                    <Button Style="{StaticResource GhostButton}" Command="{Binding RefreshSuggestionsCommand}" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding [RefreshSuggestions], Source={x:Static l:Loc.I}}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource AccentButton}" Command="{Binding CleanSelectedCommand}" MinWidth="120">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding [CleanSelected], Source={x:Static l:Loc.I}}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <Border />
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ======================================================== dock -->
            <Grid Grid.Row="4" HorizontalAlignment="Center" Margin="0,14,0,16">
                <Border CornerRadius="22" Background="#000000">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.5" Color="Black" />
                    </Border.Effect>
                </Border>
                <Border CornerRadius="22" Background="{DynamicResource IslandBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}"
                        BorderThickness="1" Padding="6">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource DockItem}" GroupName="view" AutomationProperties.Name="{Binding [ViewFolders], Source={x:Static l:Loc.I}}"
                                     IsChecked="{Binding SelectedView, Converter={StaticResource Eq}, ConverterParameter=0}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="15" Margin="0,0,9,0" />
                                <TextBlock Text="{Binding [ViewFolders], Source={x:Static l:Loc.I}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource DockItem}" GroupName="view" AutomationProperties.Name="{Binding [ViewLargeFiles], Source={x:Static l:Loc.I}}"
                                     IsChecked="{Binding SelectedView, Converter={StaticResource Eq}, ConverterParameter=1}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="15" Margin="0,0,9,0" />
                                <TextBlock Text="{Binding [ViewLargeFiles], Source={x:Static l:Loc.I}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource DockItem}" GroupName="view" AutomationProperties.Name="{Binding [ViewTypes], Source={x:Static l:Loc.I}}"
                                     IsChecked="{Binding SelectedView, Converter={StaticResource Eq}, ConverterParameter=3}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEB05;" FontSize="15" Margin="0,0,9,0" />
                                <TextBlock Text="{Binding [ViewTypes], Source={x:Static l:Loc.I}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <Border Width="1" Margin="6,10" Background="{DynamicResource SubtleBorderBrush}" />
                        <RadioButton Style="{StaticResource DockItem}" GroupName="view" AutomationProperties.Name="{Binding [ViewSuggestions], Source={x:Static l:Loc.I}}" ToolTip="{Binding [ReclaimableTip], Source={x:Static l:Loc.I}}"
                                     IsChecked="{Binding SelectedView, Converter={StaticResource Eq}, ConverterParameter=2}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="15" Margin="0,0,9,0" />
                                <TextBlock Text="{Binding [ViewSuggestions], Source={x:Static l:Loc.I}}" VerticalAlignment="Center" />
                                <Border CornerRadius="8" Background="{DynamicResource AccentGradientBrush}" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding HasReclaimable, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{Binding ReclaimableText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentForegroundBrush}" />
                                </Border>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
